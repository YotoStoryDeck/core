# ==============================================================================
# StoryDeck Core Environment Configuration
# ==============================================================================
# Note: Most application settings, child profiles, permissions, and service
# credentials (ABS, Yoto Cloud, Yoto Bridge) are managed directly via the
# Web Admin portal (http://localhost:5055/admin) and stored in SQLite.
#
# The variables below configure the host networking, database location,
# session security, and optional initial bootstrap values.
# ==============================================================================

# ==============================================================================
# Server & Session Security
# ==============================================================================
PORT=5055
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secure_hex_key

# Reverse-Proxy IP allowlist for SSO headers (e.g. Authentik, NPM, Cloudflare Access)
TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16,192.168.1.0/24

# ==============================================================================
# Storage Paths (inside container)
# ==============================================================================
DB_PATH=/app/data/broker.db
CACHE_DIR=/app/cache/thumbnails
THUMBNAIL_SIZE=100

# ==============================================================================
# Optional: Audiobookshelf Configuration & Bridge Connection (Required if using the Bridge; Can also be set in Web Admin at /admin/settings)
# Note: You can reuse the exact same Master API Key configured in your Bridge config.yaml
# ==============================================================================
# ABS_BASE_URL=http://your-audiobookshelf-server:13378
# ABS_API_KEY=your_abs_api_key_here
# YOTO_BRIDGE_URL=http://192.168.1.50:8090

# ==============================================================================
# Optional: Yoto Cloud (Can also be set in Web Admin at /admin/settings)
# ==============================================================================
# YOTO_CLIENT_ID=your_yoto_developer_client_id
# YOTO_CLIENT_SECRET=your_yoto_developer_client_secret
# YOTO_REFRESH_TOKEN=your_yoto_oauth_refresh_token

# ==============================================================================
# Optional: AI Chapter Artwork Generation
# ==============================================================================
AI_CHAPTER_ART_ENABLED=false
# AI_PROVIDER=openrouter  # openrouter | gemini | claude
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=