# ==============================================================================
# Yoto & Audiobookshelf ESP32 Middleware Broker Configuration
# ==============================================================================

# Port to listen on (default: 5055)
PORT=5055

# Audiobookshelf Server Configuration
# Use container name inside Docker network (e.g. http://audiobookshelf:80) or host IP (http://192.168.1.11:1337)
ABS_BASE_URL=http://audiobookshelf:80
ABS_API_KEY=your_abs_admin_or_service_api_key

# Yoto Developer Application Credentials (https://dashboard.yoto.dev)
YOTO_CLIENT_ID=your_yoto_client_id
YOTO_CLIENT_SECRET=your_yoto_client_secret
YOTO_REFRESH_TOKEN=your_yoto_oauth_refresh_token

# Yoto-Audiobookshelf Bridge (for streaming ABS books onto Yoto cards and fallback icons)
YOTO_BRIDGE_URL=http://yoto-bridge:8080

# Disk Cache & Thumbnail Dimensions
CACHE_DIR=/app/cache/thumbnails
THUMBNAIL_SIZE=100
LOG_LEVEL=INFO

# ==============================================================================
# Optional: Multi-Platform AI Chapter Artwork Generation
# ==============================================================================
# Master Toggle: true | false (default: false)
# When false or unconfigured, chapter artwork gracefully falls back to Yoto ABS Bridge icons.
AI_CHAPTER_ART_ENABLED=false

# Active Provider: gemini | claude | openrouter
AI_PROVIDER=openrouter

# 1. Google Gemini / Antigravity
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. OpenRouter (Unified multi-model API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ==============================================================================
# Security, Reverse-Proxy SSO & Database Persistence
# ==============================================================================
# Database file location (default: /app/data/broker.db)
DB_PATH=/app/data/broker.db
FIRMWARE_DIR=/app/data/firmware

# Secret key for HTTP session cookies (auto-generated if unset)
SECRET_KEY=generate_a_random_hex_string_for_production

# Reverse-Proxy IP allowlist for SSO headers (e.g. Authentik, Cloudflare Access)
# Comma-separated list of trusted proxy IPs or CIDR blocks
TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16,192.168.1.10
