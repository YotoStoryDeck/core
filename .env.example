# ==============================================================================
# StoryDeck Core Environment Configuration
# ==============================================================================
# Note: Most application settings, child profiles, permissions, and service
# credentials (ABS, Yoto Cloud, Yoto Bridge) are managed directly via the
# Web Admin portal (http://localhost:5055/admin) and stored in SQLite.
#
# The variables below configure the host networking, database location,
# session security, and optional initial bootstrap values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Port to listen on (default: 5055)
PORT=5055
LOG_LEVEL=INFO

# Reverse-Proxy IP allowlist for SSO headers (e.g. Authentik, NPM, Cloudflare Access)
# Comma-separated list of trusted proxy IPs or CIDR blocks
TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16,192.168.1.0/24

# ------------------------------------------------------------------------------
# 2. Database & Storage Paths
# ------------------------------------------------------------------------------
# Database file location (default: /app/data/broker.db in Docker, data/broker.db locally)
DB_PATH=/app/data/broker.db
CACHE_DIR=/app/cache/thumbnails
FIRMWARE_DIR=/app/data/firmware
THUMBNAIL_SIZE=100

# ------------------------------------------------------------------------------
# 3. Session Security
# ------------------------------------------------------------------------------
# Secret key for HTTP session cookies (auto-generated if unset)
SECRET_KEY=generate_a_random_hex_string_for_production

# ------------------------------------------------------------------------------
# 4. Initial Bootstrap / Fallback Credentials (Optional)
# If provided, these will seed the database on initial boot if not already configured in Web Admin.
# ------------------------------------------------------------------------------
# ABS_BASE_URL=http://audiobookshelf:80
# ABS_API_KEY=your_abs_admin_or_service_api_key
# YOTO_CLIENT_ID=your_yoto_client_id
# YOTO_CLIENT_SECRET=your_yoto_client_secret
# YOTO_REFRESH_TOKEN=your_yoto_oauth_refresh_token
# YOTO_BRIDGE_URL=http://yoto-bridge:8080

# ------------------------------------------------------------------------------
# 5. Optional AI Chapter Artwork Generation
# ------------------------------------------------------------------------------
AI_CHAPTER_ART_ENABLED=false
# AI_PROVIDER=openrouter  # gemini | claude | openrouter
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
